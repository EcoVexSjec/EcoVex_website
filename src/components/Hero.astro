---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="hero-section font-sans">
    <!-- Subtle Grid Background -->
    <div class="grid-bg"></div>

    <!-- Large Background Angled Logo -->
    <div class="bg-logo-container animate-float">
      <img
        src="/EcoVex_website/logo.png"
        alt="EcoVex Logo"
        class="bg-logo"
      />
    </div>

    <!-- Decorative Blobs -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <div class="hero-content">
      <!-- Main Heading -->
      <div class="heading-wrapper">
        <h1 id="hero-title" class="hero-title animate-fade-in-up">
          <span class="inline-block">Innovate.</span>
          <br class="break-desktop" />
          <span class="inline-block">Sustain.</span>
          <span class="inline-block whitespace-nowrap gradient-text">
            EcoVex.
          </span>
        </h1>

        <!-- Subtext -->
        <p id="hero-subtext" class="hero-subtext animate-fade-in-up" style="animation-delay: 0.2s;">
          Dedicated to promoting <span class="highlight-text">environmental awareness</span>, organizing eco-friendly events, and showcasing innovative projects for a greener future at SJEC.
        </p>

        <!-- Call to Action -->
        <div id="hero-cta" class="hero-cta animate-fade-in-up" style="animation-delay: 0.4s;">
          <a
            href={`${import.meta.env.BASE_URL}projects`}
            class="btn-primary group"
          >
            Our Projects
            <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <a
            href={`${import.meta.env.BASE_URL}event`}
            class="btn-secondary"
          >
            Events
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  .font-sans {
    font-family: "Anta", "Google Sans", sans-serif;
  }

  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #070d0b;
    color: white;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: 
      linear-gradient(rgba(0, 150, 136, 0.1) 1px, transparent 1px), 
      linear-gradient(90deg, rgba(0, 150, 136, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .bg-logo-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-15deg) scale(0.9);
    z-index: 0;
    opacity: 0.15;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .bg-logo-container {
      transform: translate(-50%, -50%) rotate(-15deg) scale(1.2);
    }
  }

  @media (min-width: 768px) {
    .bg-logo-container {
      transform: translate(-50%, -50%) rotate(-15deg) scale(1.6);
    }
  }

  @media (min-width: 1024px) {
    .bg-logo-container {
      transform: translate(-50%, -50%) rotate(-15deg) scale(2.0);
    }
  }

  .bg-logo {
    width: 400px;
    height: auto;
  }

  .blob {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .blob-1 {
    top: 20%;
    left: -80px;
    background-color: rgba(0, 150, 136, 0.15);
  }

  .blob-2 {
    top: 40%;
    right: -80px;
    background-color: rgba(139, 195, 74, 0.15);
    animation-delay: 2s;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .5; }
  }

  .hero-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .heading-wrapper {
    max-width: 1024px;
    text-align: center;
    padding-top: 80px;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: bold;
    color: white;
    line-height: 1.1;
    letter-spacing: -0.05em;
    margin-bottom: 32px;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 5rem;
      line-height: 1;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 6rem;
    }
  }

  .inline-block {
    display: inline-block;
  }

  .break-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .break-desktop {
      display: block;
    }
  }

  .whitespace-nowrap {
    white-space: nowrap;
  }

  .gradient-text {
    background: linear-gradient(135deg, #8bc34a, #009688);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtext {
    max-width: 600px;
    margin: 0 auto 48px auto;
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.625;
  }

  @media (min-width: 768px) {
    .hero-subtext {
      font-size: 1.25rem;
    }
  }

  .highlight-text {
    font-weight: bold;
    color: white;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .hero-cta {
      flex-direction: row;
    }
  }

  .btn-primary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 40px;
    background-color: white;
    color: #070d0b;
    font-weight: bold;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transition: all 0.3s ease;
  }

  .btn-primary:hover {
    transform: scale(1.05);
  }

  .btn-primary:active {
    transform: scale(0.95);
  }

  .btn-secondary {
    padding: 16px 40px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    font-weight: bold;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .chevron {
    transition: transform 0.3s ease;
  }

  .group:hover .chevron {
    transform: translateX(4px);
  }

  @keyframes float {
    0%, 100% { transform: translate(-50%, -50%) rotate(-15deg) scale(0.9); }
    50% { transform: translate(-50%, calc(-50% - 15px)) rotate(-13deg) scale(0.9); }
  }

  @media (min-width: 640px) {
    @keyframes float {
      0%, 100% { transform: translate(-50%, -50%) rotate(-15deg) scale(1.2); }
      50% { transform: translate(-50%, calc(-50% - 15px)) rotate(-13deg) scale(1.2); }
    }
  }

  @media (min-width: 768px) {
    @keyframes float {
      0%, 100% { transform: translate(-50%, -50%) rotate(-15deg) scale(1.6); }
      50% { transform: translate(-50%, calc(-50% - 15px)) rotate(-13deg) scale(1.6); }
    }
  }

  @media (min-width: 1024px) {
    @keyframes float {
      0%, 100% { transform: translate(-50%, -50%) rotate(-15deg) scale(2.0); }
      50% { transform: translate(-50%, calc(-50% - 15px)) rotate(-13deg) scale(2.0); }
    }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-float {
    animation: float 8s ease-in-out infinite;
  }

  .animate-fade-in-up {
    animation: fadeInUp 1.2s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    opacity: 0;
  }
</style>
