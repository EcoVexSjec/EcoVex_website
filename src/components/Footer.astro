---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="main">
    <div class="footer">
      <div class="footer-top">
        <a class="info">
          <img
            src="/EcoVex_website/logo.png"
            alt="EcoVex Logo"
            class="footer-logo"
          />
          <h2 class="footer-title">EcoVex SJEC</h2>
        </a>
        <div class="footer-con">
          <h4 class="footer-con-title">Contact Us</h4>
          <ul>
            <li>
              <a
                href="mailto:ecoclub@sjec.ac.in?subject=Eco%20Club%20Inquiry&body=Hello,%20I%20would%20like%20to%20know%20more%20about%20the%20club."
                target="_blank"
                class="social-icon"
                ><svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 640 640"
                  fill="currentColor"
                  width="25"
                  height="25"
                  ><path
                    d="M125.4 128C91.5 128 64 155.5 64 189.4C64 190.3 64 191.1 64.1 192L64 192L64 448C64 483.3 92.7 512 128 512L512 512C547.3 512 576 483.3 576 448L576 192L575.9 192C575.9 191.1 576 190.3 576 189.4C576 155.5 548.5 128 514.6 128L125.4 128zM528 256.3L528 448C528 456.8 520.8 464 512 464L128 464C119.2 464 112 456.8 112 448L112 256.3L266.8 373.7C298.2 397.6 341.7 397.6 373.2 373.7L528 256.3zM112 189.4C112 182 118 176 125.4 176L514.6 176C522 176 528 182 528 189.4C528 193.6 526 197.6 522.7 200.1L344.2 335.5C329.9 346.3 310.1 346.3 295.8 335.5L117.3 200.1C114 197.6 112 193.6 112 189.4z"
                  ></path></svg
                ></a
              >
            </li>
            <li>
              <a
                href="https://github.com/EcoVexSjec"
                aria-label="GitHub"
                class="social-icon"
                ><svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="20"
                  height="20"
                  ><path
                    d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
                  ></path></svg
                ></a
              >
            </li>
            <li>
              <a
                href="https://www.instagram.com/ecovex.sjec/"
                aria-label="Instagram"
                class="social-icon"
                ><svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  width="20"
                  height="20"
                  ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                  ></rect><circle cx="12" cy="12" r="4"></circle><circle
                    cx="17.5"
                    cy="6.5"
                    r="1"
                    fill="currentColor"
                    stroke="none"></circle></svg
                ></a
              >
            </li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-copy">© {new Date().getFullYear()} EcoVex SJEC.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .main {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    width: 100%;
  }
  .footer {
    background-color: #0f1410;
    color: #a0ac9f;
    padding: 60px 60px 30px;
    border-top: 1px solid rgba(0, 150, 136, 0.2);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto 40px auto;
  }

  .info {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .footer-logo {
    width: 60px;
  }

  .footer-title {
    font-size: 20px;
    color: #e0f2f1;
  }

  .footer-con {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .footer-con-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #e8ede6;
    margin-bottom: 15px;
  }

  .footer-con ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    gap: 15px;
  }

  .footer-con a {
    color: #a0ac9f;
    text-decoration: none;
    font-size: 16px;
    transition: color 0.2s ease;
  }

  .footer-con a:hover {
    color: #34e9bd;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 24px;
    border-top: 1px solid rgba(0, 150, 136, 0.2);
    max-width: 1200px;
    margin: 0 auto;
  }

  .social-icon {
    color: #a0ac9f;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .social-icon:hover {
    color: #34e9bd;
    transform: translateY(-2px);
  }

  .footer-copy {
    font-size: 16px;
    color: #5a6459;
  }

  @media (max-width: 600px) {
    .footer {
      padding: 40px 20px;
    }
    .footer-top {
      flex-direction: column;
      gap: 30px;
    }
    .footer-con {
      align-items: center;
    }
    .footer-con-title {
      text-align: center;
    }
  }
</style>
