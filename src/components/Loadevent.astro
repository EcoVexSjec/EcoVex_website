---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div id="main">
    <h1 id="head">Event <span class="gradient">TIMELINE</span></h1>
    <p id="para">
      Explore our journey through workshops, hackathons, and tech talks on
      campus.
    </p>
    <div id="project">
      <a href="/EcoVex_website/events/waterday" class="link">
        <div class="container">
          <div class="img"></div>
          <h3 class="time">12-05-2023</h3>
          <h3 class="title">World Water Day</h3>
          <p class="content">
            Project Clover is our flagship initiative, focused on developing a
            cutting-edge electric vehicle that combines sustainability with high
            performance.
          </p>
          <span class="type">workshop</span>
          <span class="incomplete">incomplete</span>
        </div>
      </a>
      <a href="/EcoVex_website/events/waterday" class="link">
        <div class="container">
          <div class="img"></div>
          <h3 class="time">12-05-2023</h3>
          <h3 class="title">World Water Day</h3>
          <p class="content">
            Project Clover is our flagship initiative, focused on developing a
            cutting-edge electric vehicle that combines sustainability with high
            performance.
          </p>
          <span class="type">workshop</span>
          <span class="progress">complete</span>
        </div>
      </a>
      <a href="/EcoVex_website/events/waterday" class="link">
        <div class="container">
          <div class="img"></div>
          <h3 class="time">12-05-2023</h3>
          <h3 class="title">World Water Day</h3>
          <p class="content">
            Project Clover is our flagship initiative, focused on developing a
            cutting-edge electric vehicle that combines sustainability with high
            performance.
          </p>
          <span class="type">workshop</span>
          <span class="progress">complete</span>
        </div>
      </a>
      <a href="/EcoVex_website/events/waterday" class="link">
        <div class="container">
          <div class="img"></div>
          <h3 class="time">15-06-2023</h3>
          <h3 class="title">Eco Hackathon</h3>
          <p class="content">
            Join us for a 24-hour hackathon focused on building sustainable software solutions to combat climate change and reduce carbon footprints.
          </p>
          <span class="type">hackathon</span>
          <span class="incomplete">upcoming</span>
        </div>
      </a>
    </div>
    <div class="loading">
      <a href="/EcoVex_website/event" class="load">View Event Highlights</a>
    </div>
  </div>
</Layout>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  #main {
    min-height: 100vh;
    height: auto;
    background-color: #0f1410;
    padding-bottom: 40px;
  }
  .container {
    background-color: #0096880d;
    border: 1px solid rgba(0, 150, 136, 0.2);
    text-align: center;
    border-radius: 20px;
    margin: 10px;
    padding: 40px;
    justify-items: start;
    transition: translate ease;
    height: 100%;
  }
  #project {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    justify-content: center;
    max-width: 1600px;
    margin: 0 auto;
    padding: 20px 40px 40px 40px;
  }
  .img {
    background-color: #ffffff1a;
    border-radius: 50%;
    margin-bottom: 30px;
    width: 150px;
    height: 150px;
    margin-left: auto;
    margin-right: auto;
    background-image: url("/logo1.jpeg");
    background-size: 130px;
    background-position: center;
    background-repeat: no-repeat;
    margin-top: 15px;
    border: 2px solid rgba(0, 150, 136, 0.2);
  }
  .time {
    color: #e0f2f1;
    font-size: 16px;
    margin-bottom: 20px;
    margin-left: auto;
    margin-right: auto;
  }
  .title {
    color: #e0f2f1;
    font-size: 24px;
    margin-bottom: 20px;
  }
  .content {
    color: #a0ac9f;
    font-size: 16px;
    margin-bottom: 40px;
  }
  .container:hover {
    translate: 0 -10px;
    box-shadow: rgba(52, 211, 153, 0.3) 0px 10px 30px -10px;
  }
  .container:hover .img {
    translate: 0 -10px;
    box-shadow: rgba(52, 211, 153, 0.3) 0px 10px 30px -10px;
  }
  .type {
    border: 1px solid #a0ac9f;
    background-color: #ffffff0d;
    color: #a0ac9f;
    border-radius: 15px;
    font-size: 12px;
    padding: 6px 12px;
    margin-right: 8px;
    display: inline-block;
    margin-bottom: 10px;
  }
  .progress {
    border: 1px solid #ffffff1a;
    background-color: #10fb981a;
    padding: 6px 12px;
    color: #e0f2f1;
    border-radius: 15px;
    font-size: 12px;
    display: inline-block;
  }
  .incomplete {
    border: 1px solid #ffffff1a;
    background-color: #2d1a1a;
    color: #e0f2f1;
    border-radius: 15px;
    font-size: 12px;
    padding: 6px 12px;
    display: inline-block;
  }
  #head {
    font-size: 48px;
    color: #e0f2f1;
    text-align: center;
    padding-top: 100px;
    padding-left: 20px;
    padding-right: 20px;
  }
  .gradient {
    background: linear-gradient(135deg, #4a7c44 0%, #34e9bd 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  #para {
    color: #a0ac9f;
    font-size: 18px;
    text-align: center;
    margin-top: 10px;
    padding-bottom: 60px;
    padding-left: 30px;
    padding-right: 30px;
  }
  .load {
    text-decoration: none;
    color: #e0f2f1;
    background-color: #ffffff0d;
    padding: 16px 32px;
    border-radius: 50px;
    border: 1.2px solid #34e9bd;
    font-weight: bold;
    font-size: 16px;
    transition: all 0.2s ease;
  }
  .load:hover {
    background-color: #ffffff1a;
    transform: scale(1.05);
  }
  .link {
    text-decoration: none;
    display: flex;
  }
  .loading {
    padding: 60px 20px;
    margin-top: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Mobile horizontal scroll / marquee */
  @media (max-width: 500px) {
    #project {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      justify-content: flex-start;
      padding: 20px 20px 40px 20px;
      gap: 20px;
      -ms-overflow-style: none; /* IE and Edge */
      scrollbar-width: none; /* Firefox */
    }
    
    #project::-webkit-scrollbar {
      display: none; /* Chrome, Safari and Opera */
    }

    .link {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }
    
    .container {
      width: 100%;
    }
  }
</style>
