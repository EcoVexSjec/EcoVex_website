<script>
  function initLoadMore() {
    const projectContainer = document.getElementById('project');
    if (!projectContainer) return;
    
    const cards = Array.from(projectContainer.children);
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreContainer = document.getElementById('load-more-container');
    
    let visibleCount = 9;

    function updateVisibility() {
      cards.forEach((card, index) => {
        if (index >= visibleCount) {
          card.style.display = 'none';
        } else {
          card.style.display = '';
        }
      });
      
      if (cards.length > visibleCount) {
        if (loadMoreContainer) loadMoreContainer.style.display = 'flex';
      } else {
        if (loadMoreContainer) loadMoreContainer.style.display = 'none';
      }
    }

    if (cards.length > 0) {
      updateVisibility();
    }

    if (loadMoreBtn) {
      // remove old event listeners
      const newBtn = loadMoreBtn.cloneNode(true);
      if (loadMoreBtn.parentNode) {
        loadMoreBtn.parentNode.replaceChild(newBtn, loadMoreBtn);
      }
      
      newBtn.addEventListener('click', () => {
        visibleCount += 9;
        updateVisibility();
      });
    }
  }

  initLoadMore();
  document.addEventListener('astro:page-load', initLoadMore);
</script>


<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  #main {
    min-height: 170vh;
    height: auto;
    background-color: #0a0f0a;
  }
  .container {
    background-color: #0096880d;
    border: 1px solid rgba(0, 150, 136, 0.2);
    text-align: center;
    border-radius: 20px;
    margin: 20px;
    padding: 40px;
    border-radius: 20px;
    justify-items: start;
  }
  #project {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
    gap: 30px;
    justify-content: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  @media (min-width: 768px) {
    #project {
      padding: 0 40px;
    }
  }
  #img {
    background-color: #ffffff1a;
    border-radius: 20px;
    margin-bottom: 25px;
    width: 100%;
    height: 250px;
    background-image: url("/EcoVex_website/logo.png");
    background-size: 250px;
    background-position: center;
    background-repeat: no-repeat;
  }
  .container h3 {
    color: #e0f2f1;
    font-size: 22px;
    margin-bottom: 15px;
  }
  .para1 {
    color: #a0ac9f;
    font-size: 13px;
    margin-bottom: 20px;
    text-overflow: ellipsis;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  #contributors .name {
    color: #a0ac9f;
    font-size: 16px;
    padding-bottom: 20px;
    margin-left: 10px;
  }
  .container:hover {
    translate: 0 -5px;
    box-shadow: rgba(52, 211, 153, 0.3) 0px 10px 20px -10px;
    #img {
      background-size: 265px;
    }
  }
  #contributors {
    border-top: 1px solid #ffffff1a;
    width: 100%;
    justify-items: start;
  }
  #contributors h4 {
    color: #a0ac9f;
    font-size: 12px;
    margin-bottom: 10px;
    text-align: left;
    padding-left: 10px;
    margin-top: 10px;
  }
  #contributors p {
    color: #e0f2f1;
    font-size: 16px;
    margin-bottom: 10px;
    text-align: left;
    padding-left: 20px;
  }
  .tech-stack {
    display: inline-block;
    background-color: #101c18;
    color: #34e9bd;
    padding: 5px 10px;
    border-radius: 15px;
    font-size: 12px;
    border: 1px solid #4db6ac;
  }
  #head {
    font-size: 48px;
    color: #e0f2f1;
    text-align: center;
    padding-top: 130px;
  }
  .gradient {
    background: linear-gradient(135deg, #4a7c44 0%, #34e9bd 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  #para {
    color: #a0ac9f;
    font-size: 18px;
    text-align: center;
    margin-top: 10px;
    padding-bottom: 100px;
    padding-left: 30px;
    padding-right: 30px;
  }
  a {
    text-decoration: none;
  }

  .loading-container {
    padding: 60px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .load-btn {
    text-decoration: none;
    color: #e0f2f1;
    background-color: transparent;
    padding: 16px 40px;
    border-radius: 50px;
    border: 1.5px solid #34e9bd;
    font-weight: bold;
    font-size: 16px;
    transition: all 0.3s ease;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(52, 233, 189, 0.1);
  }
  .load-btn:hover {
    background-color: rgba(52, 233, 189, 0.1);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(52, 233, 189, 0.2);
  }
</style>
